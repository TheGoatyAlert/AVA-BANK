<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="rabota.PaymentsWindow"
        x:CompileBindings="False"
        Width="1200"
        Height="700"
        Title="Платежи"
        Background="#202520">

    <Grid RowDefinitions="Auto,Auto,*"
          Margin="20">

        <Grid ColumnDefinitions="*,120"
              ColumnSpacing="10">

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Height="42"
                     FontSize="15"
                     PlaceholderText="Поиск по номеру счета"/>

            <Button x:Name="SearchButton"
                    Grid.Column="1"
                    Content="Поиск"
                    Height="42"/>

        </Grid>

        <TextBlock x:Name="CountText"
                   Grid.Row="1"
                   FontSize="16"
                   Foreground="#D4AF37"
                   Margin="0,12,0,15"/>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <ItemsControl x:Name="PaymentsList">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border Background="#292F29"
                                BorderBrush="#D4AF37"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18"
                                Margin="0,0,0,12">

                            <Grid ColumnDefinitions="90,240,180,*,180"
                                  RowDefinitions="Auto,Auto">

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ID"
                                               FontSize="12"
                                               Foreground="#999999"/>

                                    <TextBlock Text="{Binding PaymentId}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#D4AF37"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Счет"
                                               FontSize="12"
                                               Foreground="#999999"/>

                                    <TextBlock Text="{Binding AccountNumber}"
                                               FontSize="15"
                                               Foreground="White"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Сумма"
                                               FontSize="12"
                                               Foreground="#999999"/>

                                    <TextBlock Text="{Binding Amount}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#D4AF37"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Назначение"
                                               FontSize="12"
                                               Foreground="#999999"/>

                                    <TextBlock Text="{Binding Purpose}"
                                               FontSize="15"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Статус"
                                               FontSize="12"
                                               Foreground="#999999"/>

                                    <TextBlock Text="{Binding Status}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#D4AF37"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="0,18,0,0">

                                    <TextBlock Text="Дата платежа"
                                               FontSize="12"
                                               Foreground="#999999"/>

                                    <TextBlock Text="{Binding PaymentDate}"
                                               FontSize="14"
                                               Foreground="White"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</Window>