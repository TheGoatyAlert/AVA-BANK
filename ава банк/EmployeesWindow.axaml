<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="rabota.EmployeesWindow"
        x:CompileBindings="False"
        Width="1200"
        Height="700"
        Title="Сотрудники"
        Background="#202520">

    <Grid RowDefinitions="Auto,Auto,*"
          Margin="20">

        <TextBlock Text="Сотрудники банка"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#D4AF37"/>

        <TextBlock Grid.Row="1"
                   x:Name="CountText"
                   FontSize="16"
                   Foreground="#D4AF37"
                   Margin="0,10,0,15"/>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <ItemsControl x:Name="EmployeesList">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border Background="#292F29"
                                BorderBrush="#D4AF37"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,12">

                            <Grid ColumnDefinitions="180,230,180,180,*"
                                  RowDefinitions="Auto,Auto">

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ФИО"
                                               FontSize="12"
                                               Foreground="#999999"/>

                                    <TextBlock Text="{Binding FullName}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Должность"
                                               FontSize="12"
                                               Foreground="#999999"/>

                                    <TextBlock Text="{Binding Position}"
                                               FontSize="15"
                                               Foreground="White"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Телефон"
                                               FontSize="12"
                                               Foreground="#999999"/>

                                    <TextBlock Text="{Binding Phone}"
                                               FontSize="15"
                                               Foreground="White"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Email"
                                               FontSize="12"
                                               Foreground="#999999"/>

                                    <TextBlock Text="{Binding Email}"
                                               FontSize="15"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Отделение"
                                               FontSize="12"
                                               Foreground="#999999"/>

                                    <TextBlock Text="{Binding BranchName}"
                                               FontSize="15"
                                               Foreground="#D4AF37"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,15,0,0">

                                    <TextBlock Text="ID сотрудника"
                                               FontSize="12"
                                               Foreground="#999999"/>

                                    <TextBlock Text="{Binding EmployeeId}"
                                               FontSize="14"
                                               Foreground="White"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,15,0,0">

                                    <TextBlock Text="Дата приема"
                                               FontSize="12"
                                               Foreground="#999999"/>

                                    <TextBlock Text="{Binding HireDate}"
                                               FontSize="14"
                                               Foreground="White"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</Window>