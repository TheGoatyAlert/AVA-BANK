<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="rabota.ClientsWindow"
        x:CompileBindings="False"
        Width="1200"
        Height="700"
        Title="Клиенты"
        Background="#202520">

    <Grid RowDefinitions="Auto,Auto,*"
          Margin="20">

        <Grid ColumnDefinitions="*,120,120"
              ColumnSpacing="10">

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Height="42"
                     FontSize="15"
                     PlaceholderText="Поиск по ФИО, телефону или Email"/>

            <Button x:Name="SearchButton"
                    Grid.Column="1"
                    Content="Поиск"
                    Height="42"/>

            <Button x:Name="AddButton"
                    Grid.Column="2"
                    Content="Добавить"
                    Height="42"/>

        </Grid>

        <TextBlock x:Name="CountText"
                   Grid.Row="1"
                   FontSize="16"
                   Foreground="#D4AF37"
                   Margin="0,12,0,15"/>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <ItemsControl x:Name="ClientsList">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border Background="#292F29"
                                BorderBrush="#D4AF37"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18"
                                Margin="0,0,0,12">

                            <Grid ColumnDefinitions="250,180,220,*"
                                  RowDefinitions="Auto,Auto,Auto">

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ФИО клиента"
                                               FontSize="12"
                                               Foreground="#999999"/>

                                    <TextBlock Text="{Binding FullName}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Телефон"
                                               FontSize="12"
                                               Foreground="#999999"/>

                                    <TextBlock Text="{Binding Phone}"
                                               FontSize="15"
                                               Foreground="White"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Email"
                                               FontSize="12"
                                               Foreground="#999999"/>

                                    <TextBlock Text="{Binding Email}"
                                               FontSize="15"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Паспорт"
                                               FontSize="12"
                                               Foreground="#999999"/>

                                    <TextBlock Text="{Binding PassportData}"
                                               FontSize="15"
                                               Foreground="White"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Margin="0,18,20,0">

                                    <TextBlock Text="Адрес"
                                               FontSize="12"
                                               Foreground="#999999"/>

                                    <TextBlock Text="{Binding Address}"
                                               FontSize="14"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="0,18,0,0">

                                    <TextBlock Text="Дата рождения"
                                               FontSize="12"
                                               Foreground="#999999"/>

                                    <TextBlock Text="{Binding BirthDate}"
                                               FontSize="14"
                                               Foreground="White"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.Column="3"
                                            Margin="0,18,0,0">

                                    <TextBlock Text="ID клиента"
                                               FontSize="12"
                                               Foreground="#999999"/>

                                    <TextBlock Text="{Binding ClientId}"
                                               FontSize="14"
                                               Foreground="#D4AF37"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</Window>